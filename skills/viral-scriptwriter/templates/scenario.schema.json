{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vertical 3D script production handoff v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version", "title", "concept", "format", "aspect_ratio", "language",
    "idea_id", "duration", "selected_hook", "voice", "scenes", "sources",
    "fictional_assumptions", "constraints"
  ],
  "properties": {
    "format_version": { "const": 1 },
    "title": { "$ref": "#/$defs/text" },
    "concept": { "$ref": "#/$defs/text" },
    "format": { "$ref": "#/$defs/text" },
    "aspect_ratio": { "const": "9:16" },
    "language": { "$ref": "#/$defs/text" },
    "idea_id": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$" }
      ]
    },
    "duration": { "$ref": "#/$defs/duration" },
    "selected_hook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["first_frame", "spoken"],
      "properties": {
        "first_frame": { "$ref": "#/$defs/text" },
        "spoken": { "$ref": "#/$defs/optional_text" }
      }
    },
    "voice": { "$ref": "#/$defs/voice" },
    "scenes": { "type": "array", "items": { "$ref": "#/$defs/scene" }, "minItems": 1 },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "fictional_assumptions": { "$ref": "#/$defs/text_list" },
    "constraints": { "$ref": "#/$defs/text_list" },
    "recheck_before_publication": { "$ref": "#/$defs/text_list" }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "optional_text": {
      "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/text" }]
    },
    "text_list": { "type": "array", "items": { "$ref": "#/$defs/text" } },
    "seconds": { "type": "number", "minimum": 0 },
    "positive": { "type": "number", "exclusiveMinimum": 0 },
    "duration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_min_s", "target_max_s", "status", "total_s"],
      "properties": {
        "target_min_s": { "$ref": "#/$defs/positive" },
        "target_max_s": { "$ref": "#/$defs/positive" },
        "status": { "enum": ["preliminary", "aligned"] },
        "total_s": { "$ref": "#/$defs/positive" },
        "fps": { "$ref": "#/$defs/positive" },
        "audio_s": {
          "description": "Measured duration of the voice track in seconds.",
          "$ref": "#/$defs/positive"
        }
      }
    },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "clean_text"],
      "properties": {
        "mode": { "enum": ["single", "dialogue", "none"] },
        "model_id": { "$ref": "#/$defs/optional_text" },
        "voice_id": { "$ref": "#/$defs/optional_text" },
        "clean_text": { "$ref": "#/$defs/optional_text" },
        "settings": {
          "description": "Optional model-supported voice settings selected by the user.",
          "type": "object",
          "additionalProperties": { "type": ["number", "boolean", "string"] }
        },
        "audio_offset_s": {
          "description": "Measured voice track start on the video timeline, in seconds.",
          "$ref": "#/$defs/seconds"
        },
        "audio_ref": { "$ref": "#/$defs/text" },
        "alignment_ref": { "$ref": "#/$defs/text" },
        "dialogue": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["speaker", "text"],
            "properties": {
              "speaker": { "$ref": "#/$defs/text" },
              "text": { "$ref": "#/$defs/text" },
              "voice_id": { "$ref": "#/$defs/optional_text" }
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "none" } } },
          "then": { "properties": { "clean_text": { "type": "null" } } },
          "else": { "properties": { "clean_text": { "$ref": "#/$defs/text" } } }
        },
        {
          "if": { "properties": { "mode": { "const": "dialogue" } } },
          "then": { "required": ["dialogue"] },
          "else": { "not": { "required": ["dialogue"] } }
        }
      ]
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "start_s", "end_s", "visual_change", "environment", "characters",
        "objects", "action", "camera", "overlays", "sfx", "music",
        "background_motion", "vfx", "transition", "voice_lines"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/text" },
        "start_s": { "$ref": "#/$defs/seconds" },
        "end_s": { "$ref": "#/$defs/positive" },
        "visual_change": { "$ref": "#/$defs/text" },
        "environment": { "$ref": "#/$defs/text" },
        "characters": { "$ref": "#/$defs/text_list" },
        "objects": { "$ref": "#/$defs/text_list" },
        "action": { "$ref": "#/$defs/text" },
        "camera": { "$ref": "#/$defs/text" },
        "overlays": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text", "role", "cue"],
            "properties": {
              "text": { "$ref": "#/$defs/text" },
              "role": { "enum": ["label", "caption", "counter"] },
              "cue": { "$ref": "#/$defs/text" }
            }
          }
        },
        "sfx": { "$ref": "#/$defs/text_list" },
        "music": { "$ref": "#/$defs/optional_text" },
        "background_motion": { "$ref": "#/$defs/optional_text" },
        "vfx": { "$ref": "#/$defs/text_list" },
        "transition": { "$ref": "#/$defs/optional_text" },
        "voice_lines": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["speaker", "text"],
            "dependentRequired": {
              "start_s": ["end_s"],
              "end_s": ["start_s"]
            },
            "properties": {
              "speaker": { "$ref": "#/$defs/text" },
              "text": { "$ref": "#/$defs/text" },
              "start_s": { "$ref": "#/$defs/seconds" },
              "end_s": { "$ref": "#/$defs/positive" }
            },
            "description": "Optional measured absolute speech anchors on the video timeline."
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim", "kind", "url", "checked_on"],
      "properties": {
        "claim": { "$ref": "#/$defs/text" },
        "kind": { "enum": ["primary", "secondary", "calculation"] },
        "url": {
          "type": ["string", "null"],
          "format": "uri",
          "pattern": "^https?://[^/\\s?#]+"
        },
        "checked_on": { "type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "notes": { "$ref": "#/$defs/text" }
      },
      "if": { "properties": { "kind": { "const": "calculation" } } },
      "then": { "required": ["notes"] },
      "else": { "properties": { "url": { "type": "string" } } }
    }
  }
}
