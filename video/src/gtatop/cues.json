 "subs": [
  {
   "s": 0.033,
   "e": 3.203,
   "text": "Топ-10 героев GTA по шахматному рейтингу!"
  },
  {
   "s": 3.253,
   "e": 5.413,
   "text": "И нет, Томми не первый."
  },
  {
   "s": 5.773,
   "e": 7.053,
   "text": "Десятое место."
  },
  {
   "s": 7.233,
   "e": 8.603,
   "text": "Виктор Вэнс."
  },
  {
   "s": 8.653,
   "e": 10.943,
   "text": "Солдат, брат, бизнесмен."
  },
  {
   "s": 10.993,
   "e": 14.853,
   "text": "Его сильнейший ход: построил империю в Вайс-Сити."
  },
  {
   "s": 15.423,
   "e": 19.163,
   "text": "Его зевок: умер в самом начале следующей игры."
  },
  {
   "s": 19.743,
   "e": 22.083,
   "text": "Партия длиной в одну заставку."
  },
  {
   "s": 23.983,
   "e": 25.143,
   "text": "Девятое место."
  },
  {
   "s": 25.383,
   "e": 26.833,
   "text": "Тони Сиприани."
  },
  {
   "s": 26.883,
   "e": 30.213,
   "text": "Захватил город, разобрался с тремя мафиозными семьями."
  },
  {
   "s": 30.263,
   "e": 32.523,
   "text": "Но мама всё равно недовольна."
  },
  {
   "s": 32.923,
   "e": 35.843,
   "text": "Минус двести очков за каждый звонок от мамы."
  },
  {
   "s": 37.693,
   "e": 38.584,
   "text": "Восьмое место."
  },
  {
   "s": 38.634,
   "e": 39.404,
   "text": "Клод."
  },
  {
   "s": 39.454,
   "e": 41.984,
   "text": "Самый молчаливый игрок в истории шахмат."
  },
  {
   "s": 42.034,
   "e": 43.904,
   "text": "За всю игру ни слова."
  },
  {
   "s": 43.954,
   "e": 45.674,
   "text": "Его даже предали молча:"
  },
  {
   "s": 45.854,
   "e": 48.434,
   "text": "Каталина выстрелила и сбежала с деньгами."
  },
  {
   "s": 50.284,
   "e": 50.79,
   "text": "Седьмое место."
  },
  {
   "s": 50.84,
   "e": 52.21,
   "text": "Джонни Клебиц."
  },
  {
   "s": 52.26,
   "e": 54.61,
   "text": "Байкер, лидер, человек чести."
  },
  {
   "s": 54.66,
   "e": 56.35,
   "text": "Сыграл достойную партию."
  },
  {
   "s": 56.4,
   "e": 58.07,
   "text": "А потом встретил Тревора."
  },
  {
   "s": 58.12,
   "e": 60.14,
   "text": "Здесь комментарии излишни."
  },
  {
   "s": 61.99,
   "e": 62.744,
   "text": "Шестое место."
  },
  {
   "s": 62.794,
   "e": 64.264,
   "text": "Майкл Де Санта."
  },
  {
   "s": 64.314,
   "e": 66.824,
   "text": "Инсценировал свою смерть и ушёл на пенсию."
  },
  {
   "s": 66.874,
   "e": 68.364,
   "text": "Идеальная защита."
  },
  {
   "s": 68.414,
   "e": 71.564,
   "text": "А потом из-за ревности снёс балкон чужого дома."
  },
  {
   "s": 71.614,
   "e": 73.684,
   "text": "Как оказалось, дом наркобарона."
  },
  {
   "s": 73.734,
   "e": 75.174,
   "text": "Пенсия окончена."
  },
  {
   "s": 77.024,
   "e": 77.72,
   "text": "Пятое место."
  },
  {
   "s": 77.77,
   "e": 79.06,
   "text": "Франклин Клинтон."
  },
  {
   "s": 79.11,
   "e": 81.06,
   "text": "Начинал с угона машин за долги."
  },
  {
   "s": 81.11,
   "e": 83.97,
   "text": "Закончил домом на холмах и своим агентством."
  },
  {
   "s": 84.33,
   "e": 86.72,
   "text": "Единственная слабость — лучший друг Ламар."
  },
  {
   "s": 86.77,
   "e": 89.01,
   "text": "С таким другом враги не нужны."
  },
  {
   "s": 90.86,
   "e": 91.74,
   "text": "Четвёртое место."
  },
  {
   "s": 91.79,
   "e": 92.92,
   "text": "Тревор Филипс."
  },
  {
   "s": 92.97,
   "e": 95.82,
   "text": "Его дебют: снёс целую банду байкеров."
  },
  {
   "s": 95.87,
   "e": 97.24,
   "text": "Вместе с Джонни, кстати."
  },
  {
   "s": 97.29,
   "e": 98.24,
   "text": "Зевков нет."
  },
  {
   "s": 98.29,
   "e": 99.66,
   "text": "Не потому что их не было."
  },
  {
   "s": 99.71,
   "e": 102.35,
   "text": "Просто спрашивать его об этом никто не рискнул."
  },
  {
   "s": 104.2,
   "e": 104.993,
   "text": "Третье место!"
  },
  {
   "s": 105.043,
   "e": 106.173,
   "text": "Нико Беллик."
  },
  {
   "s": 106.223,
   "e": 107.893,
   "text": "Приехал в Америку за мечтой."
  },
  {
   "s": 107.943,
   "e": 110.213,
   "text": "Нашёл войну, мафию и месть."
  },
  {
   "s": 110.263,
   "e": 111.833,
   "text": "Сыграл как гроссмейстер."
  },
  {
   "s": 111.883,
   "e": 114.853,
   "text": "Но так и не научился отвечать кузену «нет»."
  },
  {
   "s": 114.903,
   "e": 116.783,
   "text": "«Нико, пойдём в боулинг!»"
  },
  {
   "s": 118.633,
   "e": 119.551,
   "text": "Второе место!"
  },
  {
   "s": 119.601,
   "e": 120.791,
   "text": "Томми Версетти."
  },
  {
   "s": 120.841,
   "e": 124.771,
   "text": "Пятнадцать лет тюрьмы, потерянные деньги, ни одного союзника."
  },
  {
   "s": 124.821,
   "e": 127.291,
   "text": "Через одну игру он хозяин Вайс-Сити."
  },
  {
   "s": 127.341,
   "e": 129.571,
   "text": "Ошибка одна: доверял Лэнсу."
  },
  {
   "s": 129.621,
   "e": 132.341,
   "text": "Брату того самого Виктора с десятого места."
  },
  {
   "s": 134.191,
   "e": 135.308,
   "text": "И первое место!"
  },
  {
   "s": 135.358,
   "e": 136.108,
   "text": "Си-Джей."
  },
  {
   "s": 136.158,
   "e": 138.128,
   "text": "Вернулся домой на похороны мамы,"
  },
  {
   "s": 138.178,
   "e": 140.148,
   "text": "а в итоге забрал себе весь штат:"
  },
  {
   "s": 140.198,
   "e": 142.628,
   "text": "от Гроув-стрит до казино в Лас-Вентурасе."
  },
  {
   "s": 142.678,
   "e": 146.128,
   "text": "Единственный зевок — не успел за тем самым поездом."
  },
  {
   "s": 146.178,
   "e": 149.418,
   "text": "«Всё, что надо было, это ехать за поездом, Си-Джей!»"
  },
  {
   "s": 151.268,
   "e": 152.678,
   "text": "Но таблица ещё не закрыта."
  },
  {
   "s": 152.728,
   "e": 155.018,
   "text": "Двое новых игроков садятся за доску."
  },
  {
   "s": 155.068,
   "e": 156.358,
   "text": "Джейсон и Люсия."
  },
  {
   "s": 156.408,
   "e": 158.218,
   "text": "Рейтинг: неизвестен."
  },
  {
   "s": 158.268,
   "e": 160.618,
   "text": "Первая партия: 19 ноября."
  },
  {
   "s": 160.668,
